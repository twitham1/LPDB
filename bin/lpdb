#!/usr/bin/perl

# by twitham@sbcglobal.net in 2020 based on picasagallery of 2013

use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/../lib";
use LPDB;
use Getopt::Long;

my $usage = "usage: $0 [options]
    --create		create  the Local Picture DataBase
    --upgrade		upgrade the Local Picture DataBase
    --importfiles	update the LPDB from the image and metadata files
    --updateflats	update the [Flats]	tree from the LPDB
    --updatecaptions	update the [Captions]	tree from the LPDB
    --updatefaces	update the [Faces]	tree from the LPDB
    --updatestars	update the [Stars]	tree from the LPDB
    --clean		clean the LPDB of removed files
    --updatepaths	update recursive metadata for logical [Paths]
    --all		do all of the above, a full import or refresh\n";

my @opt = qw/create upgrade importfiles updateflats updatecaptions
    updatefaces updatestars clean updatepaths all sortlist/;
my %opt;
GetOptions(\%opt, @opt)
    or die $usage;

# configuration options that can be overridden in files:
our $conf = {
    autoconfigure => 1,		# config from .lpdb.pl files
    # dbfile => '.lpdb.db',
    # thumbfile => '.lpdb-thumb.db',
    sqltrace => 0,	       # see SQL of DB updates?
    minpixels => 320 * 320 + 1,	# reject icons/thumbnails smaller than this
    profile => 1,
};

$opt{all} and map { $opt{$_} = 1 } @opt;

$opt{create} and $conf->{create} = 1;

my $lpdb = new LPDB($conf);

$lpdb->profile;
if ($opt{create} or $opt{upgrade}) {
    $lpdb->create;
    $lpdb->profile("create/upgrade");
};

if ($opt{importfiles}) {	# TODO: configurable {ext}
    my $ext;
    if ($ext = `$Bin/lpdb-ext` and chomp $ext) {
	my @ext = split ' ', $ext;
	$conf->{ext} = \@ext;	# if set, auto-sets {regex}
    }
    $lpdb->importfiles('.');
    $lpdb->profile("import files");
}

if ($opt{updateflats}) {
    $lpdb->vfs->updateflats;
    $lpdb->profile("update flats");
}

if ($opt{updatecaptions}) {
    $lpdb->vfs->updatecaptions;
    $lpdb->profile("update flats");
}

if ($opt{updatefaces}) {
    $lpdb->vfs->updatefaces;
    $lpdb->profile("update faces");
}

if ($opt{updatestars}) {
    $lpdb->vfs->updatestars;
    $lpdb->profile("update stars");
}

if ($opt{clean}) {
    $lpdb->cleanup;
    $lpdb->profile("clean");
}

if ($opt{updatepaths}) {
    $lpdb->vfs->updatepaths;
    $lpdb->profile("update paths");
}

if ($opt{sortlist}) {
    my($list, $dur) = $lpdb->vfs->pathpics("/[Timeline]/Years/2013",
	[], [{ '-asc' => 'dir.begin' }, { '-asc' => 'dir.directory' }], [], 0);
    $lpdb->profile("sort list");
}

$lpdb->disconnect;

$lpdb->profilesum;

exit 0;
